// Module github.com/seyallius/benchbook - benchmark and profile documentation tool
// with deliberate milestone history. Two dependencies, both boring: a TOML decoder for
// the configuration file and cobra for the command line. Everything else is the
// standard library.
module github.com/seyallius/benchbook

go 1.27.0

require (
	github.com/BurntSushi/toml v1.4.0
	github.com/spf13/cobra v1.10.2
)

require (
	github.com/inconshreveable/mousetrap v1.1.0 // indirect
	github.com/spf13/pflag v1.0.9 // indirect
)
